    def rodrigues_preshift_coords(self, lat_deg: float, lon_deg: float) -> tuple[float, float]:
        """Reverses the +29.98 deg crust shift around the 29.98 N, 29.98 E gyroscopic pivot."""
        theta = math.radians(-self.crust_twist_deg)
        p_lat, p_lon = math.radians(self.pivot_lat), math.radians(self.pivot_lon)
        n = (
            math.cos(p_lat) * math.cos(p_lon),
            math.cos(p_lat) * math.sin(p_lon),
            math.sin(p_lat),
        )

        s_lat, s_lon = math.radians(lat_deg), math.radians(lon_deg)
        r = (
            math.cos(s_lat) * math.cos(s_lon),
            math.cos(s_lat) * math.sin(s_lon),
            math.sin(s_lat),
        )

        # Cross product n x r and dot product n . r
        cross = (
            n[1] * r[2] - n[2] * r[1],
            n[2] * r[0] - n[0] * r[2],
            n[0] * r[1] - n[1] * r[0],
        )
        dot = n[0] * r[0] + n[1] * r[1] + n[2] * r[2]

        cos_t = math.cos(theta)
        sin_t = math.sin(theta)
        r_prime = (
            r[0] * cos_t + cross[0] * sin_t + n[0] * dot * (1.0 - cos_t),
            r[1] * cos_t + cross[1] * sin_t + n[1] * dot * (1.0 - cos_t),
            r[2] * cos_t + cross[2] * sin_t + n[2] * dot * (1.0 - cos_t),
        )

        old_lat = math.degrees(math.asin(max(-1.0, min(1.0, r_prime[2]))))
        old_lon = math.degrees(math.atan2(r_prime[1], r_prime[0]))
        return round(old_lat, 2), round(old_lon, 2)


class ThreeTumblerEngine:
    """Evaluates the Calendar, Chandler Wobble, and Base-11 Spatial Grid Tumblers."""

    def __init__(
        self,
        core: MaserEarthPhysicsCore,
        nodal_epoch: datetime.datetime = datetime.datetime(2026, 11, 13, 15, 47, 0),
        boundary_wall_years: float = 12800.0,
    ):
        self.core = core
        self.nodal_epoch = nodal_epoch
        self.boundary_wall_years = boundary_wall_years
        self.hudson_giza_arc_km = 8500.0
        self.tropical_year = 365.242189
        self.reference_ring = 360.0
        self.secular_residue = 0.019200
        self.chandler_period_days = 433.0
        self.master_cycle_years = 17500.0
        self.i_envelope = 7.2e8
        self.q_lattice = (2.0 * math.pi * self.core.f_tuesday_hz * 20.0) / 12.5
        self.coprime_ring = 1092

    def evaluate(
        self,
        target_dt: datetime.datetime,
        delta_x_km: float = 284.1,
    ) -> ThreeTumblerState:
        delta_days = (target_dt.date() - self.nodal_epoch.date()).days
        exact_days = (target_dt - self.nodal_epoch).total_seconds() / 86400.0
        elapsed_years = exact_days / self.tropical_year
        total_years = self.boundary_wall_years + elapsed_years

        # Tumbler 1: Calendar Tumbler
        sprocket_tooth = delta_days % 7
        solar_slip = (elapsed_years * (self.tropical_year - self.reference_ring)) % 7.0
        secular_days = total_years * self.secular_residue

        # Tumbler 2: Chandler Wobble Tumbler
        total_deep_days = total_years * self.tropical_year
        wobble_day = total_deep_days % self.chandler_period_days
        wobble_angle = (wobble_day / self.chandler_period_days) * 360.0

        # Tumbler 3: Geographic Grid Tumbler
        arc_pixels = self.hudson_giza_arc_km / self.core.pixel_tuesday_km
        grid_phase = (
            (arc_pixels % 1.0) * 360.0 + (delta_x_km / self.core.pixel_tuesday_km) * 360.0
        ) % 360.0

        # Combined Master Dial & Circuit Current
        master_angle = ((total_years % self.master_cycle_years) / self.master_cycle_years) * 360.0
        seconds_midnight = target_dt.hour * 3600 + target_dt.minute * 60 + target_dt.second
        minute_of_day = target_dt.hour * 60 + target_dt.minute

        damping = math.exp(-delta_x_km / (self.core.pixel_tuesday_km * self.q_lattice))
        carrier = 2.0 * math.pi * self.core.f_tuesday_hz * seconds_midnight
        shear = (2.0 * math.pi * (7 * 13 * minute_of_day)) / self.coprime_ring
        i_instant = self.i_envelope * damping * math.cos(carrier - shear)

        return ThreeTumblerState(
            timestamp=target_dt,
            day_index=delta_days,
            sprocket_tooth=sprocket_tooth,
            solar_vs_360_slip=round(solar_slip, 4),
            secular_residue_days=round(secular_days, 4),
            chandler_wobble_day=round(wobble_day, 2),
            chandler_wobble_angle_deg=round(wobble_angle, 2),
            hudson_giza_arc_pixels=round(arc_pixels, 4),
            spatial_grid_phase_deg=round(grid_phase, 2),
            master_dial_angle_deg=round(master_angle, 2),
            instantaneous_current_a=round(i_instant, 2),
        )


